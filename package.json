{
  "name": "@dsh-user/dsh-project-manager",
  "version": "0.1.0",
  "description": "DSH 项目管理插件：在 DSH Web 设置页管理开发项目——添加/删除项目、一键启动/停止/重启、文件变更热重载自动重启、实时日志查看与持久化。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/index.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "install.ps1"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/br1nosense/dsh-project-manager.git"
  },
  "homepage": "https://github.com/br1nosense/dsh-project-manager#readme",
  "bugs": {
    "url": "https://github.com/br1nosense/dsh-project-manager/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "project-manager",
    "dev",
    "hot-reload"
  ],
  "author": "br1nosense",
  "license": "MIT"
}
